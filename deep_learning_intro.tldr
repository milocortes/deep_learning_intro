n y colaboradores (2006)introdujeron, siendo una de las "}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"razones por las cuales resurgió el interés por el Deep Learning. "}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Su investigación subrayó la importancia del entrenamiento "}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"capa por capa usando métodos de aprendizaje no supervizado"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"seguido por métodos supervizados de fine-tuning para mejorar los"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"resultados del estado del árte para el reconócimiento de texto."}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"El punto de inflexión llegó en 2012, cuando la red neuronal "}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"convolucional profunda de Krizhevsky, Sutskever y Hinton superó "}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"de forma espectacular a sus competidores en la tarea de "}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"reconocimiento de imágenes ImageNet."}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"   "}]}]}},"parentId":"page:knBMRbbJW6zMjbSKJKDjz","index":"a6mtr","typeName":"shape"},{"x":-147,"y":57,"z":1,"meta":{},"id":"camera:page:ThTp6_Cp36eB1DjvSR_9P","typeName":"camera"},{"x":238.1108108108108,"y":455.1015625,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:QVNAUP_r2ZUakns4Msff9","type":"text","props":{"color":"black","size":"s","w":325.015625,"font":