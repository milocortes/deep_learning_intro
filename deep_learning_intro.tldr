e":"asset","props":{"name":"tldrawFile","src":"data:image/png;base64,","w":685,"h":323,"fileSize":146901,"mimeType":"image/png","isAnimated":false},"meta":{}},{"x":1215,"y":762,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:j81vl4skjuphvqaFcQCx7","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"l","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":-9,"y":-106},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"mono","scale":1},"parentId":"page:tNpsBwSU--q0erWPUGLE8","index":"a3xspO","typeName":"shape"},{"x":0,"y":0,"z":1,"meta":{},"id":"camera:page:page","typeName":"camera"},{"x":1125,"y":148,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:eHe1xbGAdldsAxhMRYg-Q","type":"geo","props":{"w":574,"h":611,"geo":"rectangle","dash":"draw","growY":117,"url":"","scale":1,"flipX":false,"flipY":false,"color":"black","labelColor":"black","fill":"none","size":"s","font":"mono","align":"middle","verticalAlign":"middle","richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Las neuronas son células especializadas en varias tareas.   "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Son celulas extremadamente sofisticadas que utilizan una combinación entre química y reacciones eléctricas para comunicarse entre ellas. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Las neuronas son máquinas de procesamiento de información."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"La información llega en forma de sustancias químicas llamados "},{"type":"text","marks":[{"type":"bold"}],"text":"neurotransmisores"},{"type":"text","text":" los cuales se "},{"type":"text","marks":[{"type":"bold"}],"text":"unen"},{"type":"text","text":" temporalmente a "},{"type":"text","marks":[{"type":"bold"}],"text":"receptores"},{"type":"text","text":" dentro de la neurona, provocando que se transmitan señales eléctricas (positivas o negativas) hacia el cuerpo de la neurona."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Todas las señales eléctricas que llegan al cuerpo de la neurona en un breve intervalo de tiempo se suman y, a continuación, se comparan con un "},{"type":"text","marks":[{"type":"bold"}],"text":"umbral"},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Si el total supera ese umbral, se envía una nueva señal a lo largo del axón hacia otra parte de la neurona, lo que provoca la liberación de cantidades específicas de neurotransmisores en el entorno."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Estos neurotransmisores se unen a otras neuronas, y el proceso se repite."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"De este modo, la información se propaga y se modifica a medida que fluye a través de la red densamente conectada de neuronas en el cerebro y el sistema nervioso central."}]}]}]}]}},"parentId":"page:z9ZN5NzsSe5gjBDchZpyz","index":"a4YYv","typeName":"shape"},{"x":922.5,"y":780.5,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:HZoYR0iKvuMTb6r7hn08G","type":"geo","props":{"w":782.705882352941,"h":74,"geo":"rectangle","dash":"solid","grow