							},
							"content": [
								{
									"type": "text",
									"text": "Minsky y Papert (1969) mostraron  que el SLP no podía representar funciones no lineales simples."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
